@{
    // Lấy tham số order trên URL
    string Sapxep = Context.Request.Query["sapxep"];
    // Tạo biến giá giảm giá tăng tên giảm tên tăng
    // Dùng để đánh dấu option nào đang được chọn
    string priceAsc = "", priceDesc = "", nameAsc = "", nameDesc = "";
    // Trong Class Order nếu chọn value có tên nào thì tên đó được chọn
    switch (Sapxep)
    {
        // Gán value trong Option
        case "priceAsc": priceAsc = "selected"; break;
        case "priceDesc": priceDesc = "selected"; break;
        case "nameAsc": nameAsc = "selected"; break;
        case "nameDesc": nameDesc = "selected"; break;
    }
}

  
<div class="row justify-content-center">
    <div class="col-md-10 mb-5 text-end">
            @* Xảy ra khi người dùng thay đổi giá trị trong
            location.href là địa chỉ URL hiện tại của trình duyệt
            Đổi giá trị sẽ truyền url sang ProductsController/Category
            @ViewBag.CategoryId = id tương ứng Id của sản phẩm lấy bên ProductsController/Category
            ?sapxep='+this.value => sapxep là tên lấy từ string strOrder = Context.Request.Query["order"], this là slected đang bị thay đổi, value là giá trị option được chọn *@
        <select class="form-control" onchange="location.href = '/Products/Category/@ViewBag.CategoryId?sapxep='+this.value;">
                    @* // Value biến được gán từ swtich bên trên xuống *@
                    <option value="0">Sắp xếp</option>
                    <option value="priceAsc">Giá tăng dần</option>
                    <option value="priceDesc">Giá giảm dần</option>
                    <option  value="nameAsc">Sắp xếp A-Z</option>
                    <option  value="nameDesc">Sắp xếp Z-A</option>
            </select>

    </div>
</div>

<div class="row">
    <div class="col-md-3">
        <div class="panel panel-default">
            <div class="panel-heading">Tìm theo mức giá</div>
            <div class="panel-body">
                <ul class="list-group">
                    <li class="list-group-item">
                        Giá từ
                        <input type="number" id="fromPrice" class="form-control" />
                    </li>
                    <li class="list-group-item">
                        Đến
                        <input type="number" id="toPrice" class="form-control" />
                    </li>
                    <li class="list-group-item text-center">
                        <input type="button" class="btn btn-warning w-100"
                               value="Tìm mức giá"
                               onclick="location.href='/Search/SearchPrice?fromPrice='+fromPrice.value+'&toPrice='+toPrice.value;" />
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-9">
        <div class="row">
            @if (Model == null)
            {
                <text>Model hiện tại đang null không thể hiển thị dữ liệu</text>
            }
            else
            {
                @foreach (var row in Model)
                {
                    <div class="col-md-6 col-lg-3 ftco-animate fadeInUp ftco-animated">
                        <div class="product">
                            <a href="/Products/Detail/@row.Id"><img src="~/Upload/Products/@row.Photo" title="@row.Name." alt="row.Name" class="img-responsive"></a>

                            <div class="text py-3 pb-4 px-3 text-center">
                                <h3><a href="#">@row.Name</a></h3>
                                <div class="d-flex">
                                    <div class="pricing">
                                        <p class="price"><span class="mr-2 price-dc">@string.Format("{0:N0}₫", row.Price)</span><span class="price-sale">@string.Format("{0:N0}₫", row.Price - row.Discount)</span></p>
                                    </div>
                                </div>
                                <div class="bottom-area d-flex px-3">
                                    <div class="m-auto d-flex">
                                        <a href="#" class="add-to-cart d-flex justify-content-center align-items-center text-center">
                                            <span><i class="ion-ios-menu"></i></span>
                                        </a>
                                        <a href="/Cart/Buy/@row.Id" class="buy-now d-flex justify-content-center align-items-center mx-1">
                                            <span><i class="ion-ios-cart"></i></span>
                                        </a>
                                        <a href="#" class="heart d-flex justify-content-center align-items-center ">
                                            <span><i class="ion-ios-heart"></i></span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }


            }

        </div>
        <div style="clear: both;"></div>
        <div style="" class="&#x70;&#x61;&#x67;&#x69;&#x6E;&#x61;&#x74;&#x69;&#x6F;&#x6E;&#x2D;&#x63;&#x6F;&#x6E;&#x74;&#x61;&#x69;&#x6E;&#x65;&#x72;">

            @Html.PagedListPager(
            Model,
            page => Url.Action("Category", new { page = page }))
        </div>
        
    </div>
            
</div>


<style>
    img.img-responsive {
        height: 200px;
        width: 100%;
    }
    h3{
      
    }
    /* ===== TÊN SẢN PHẨM ===== */
    .product h3 {
        font-size: 15px;
        line-height: 1.3;
        height: 40px; /* 2 dòng */
        overflow: hidden;
    }

        .product h3 a {
            display: -webkit-box;
            -webkit-line-clamp: 2; /* tối đa 2 dòng */
            -webkit-box-orient: vertical;
            overflow: hidden;
            text-overflow: ellipsis;
            color: #333;
        }

    .product .text {
        min-height: 140px;
    }
    /* ===== FIX GIÁ ===== */
    .price {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 6px;
        flex-wrap: nowrap;
        white-space: nowrap;
    }

        .price span {
            display: inline-flex;
            align-items: center;
            line-height: 1;
        }

    /* giá gốc */
    .price-dc {
        color: #999;
        font-size: 14px;
        text-decoration: line-through;
    }

    /* giá sale */
    .price-sale {
        color: #6cb33f;
        font-size: 15px;
        font-weight: 600;
    }

