@{
    //load file Layout.cshtml vao day
    Layout = "~/Areas/Admin/Views/_Shared/_Layout.cshtml";
}
@using Website.Models
@using System.IO
@functions {
    public MyDbContext db = new MyDbContext();
    public Customers GetCustomers(int _CustomerId)
    {
        //lay mot ban ghi
        Customers record = db.Customers.Where(item => item.Id == _CustomerId).FirstOrDefault();
        return record != null ? record : new Customers();
    }
    public Order GetOrders(int _OrderId)
    {
        //lay mot ban ghi
        Order record = db.Order.Where(item => item.Id == _OrderId).FirstOrDefault();
        return record != null ? record : new Order();
    }
    public Products GetProducts(int _ProductId)
    {
        //lay mot ban ghi
        Products record = db.Products.Where(item => item.Id == _ProductId).FirstOrDefault();
        return record != null ? record : new Products();
    }
}
<div class="col-md-12">
    @{
        Order recordOrders = GetOrders(ViewBag.OrderId);
    }
    <div style="margin-bottom:10px;">
        <a href="/Admin/Orders" class="btn btn-danger">Quay lại</a>&nbsp;&nbsp;
        @if (recordOrders.Status == 0)
        {
            <a href="/Admin/Orders/Delivery/@ViewBag.OrderId" class="btn btn-primary">Giao hàng</a>
        }
    </div>
    <div class="panel panel-primary">
        <div class="panel-heading">Order detail</div>
        <div class="panel-body">
            <table class="table table-bordered table-hover">
                <tr>
                    <th style="width:100px;">Photo</th>
                    <th>Name</th>
                    <th style="width:100px;">Price</th>
                    <th style="width:100px;">Quantity</th>
                </tr>
                @foreach (var item in Model)
                {
                    Products recordProducts = GetProducts(item.ProductId);
                    <tr>
                        <td>
                            @if (recordProducts.Photo != null && File.Exists(Directory.GetCurrentDirectory() + "\\wwwroot\\Upload\\Products\\" + recordProducts.Photo))
                            {
                                <img src="~/Upload/Products/@recordProducts.Photo" style="width:100px;" />
                            }
                        </td>
                        <td>@recordProducts.Name</td>
                        <td>@string.Format("{0:N0}đ", recordProducts.Price - recordProducts.Discount)</td>
                        <td style="text-align:center;">@item.Quantity</td>
                    </tr>
                }
            </table>
        </div>
    </div>
</div>
